YOUCAM_MODE=live
# API key from the console's API Keys page. Use the host that matches the portal it came from:
#   yce.perfectcorp.com          -> https://yce-api-01.perfectcorp.com
#   yce.makeupar.com (India)     -> https://yce-api-01.makeupar.com
YOUCAM_BASE_URL=https://yce-api-01.perfectcorp.com
YOUCAM_API_KEY=
# LLM (Advisor Agent, P1): groq | openai. The other provider is used as fallback if its key is set.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=file:./dev.db
